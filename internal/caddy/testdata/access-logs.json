{
  "admin": {
    "listen": "unix//run/caddy/admin.sock"
  },
  "logging": {
    "logs": {
      "access": {
        "encoder": {
          "format": "json"
        },
        "include": [
          "http.log.access"
        ],
        "writer": {
          "filename": "/data/access.log",
          "output": "file",
          "roll_keep": 5,
          "roll_size_mb": 10
        }
      },
      "default": {
        "exclude": [
          "http.log.access"
        ]
      }
    }
  },
  "apps": {
    "http": {
      "servers": {
        "http": {
          "logs": {
            "logger_names": {
              "blog.example.com": [
                "access"
              ],
              "nas.example.com": [
                "access"
              ]
            },
            "skip_unmapped_hosts": true
          },
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "naru.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "try_duration": "5s",
                    "try_interval": "250ms"
                  },
                  "upstreams": [
                    {
                      "dial": "naru:8080"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "blog.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "encodings": {
                            "gzip": {},
                            "zstd": {}
                          },
                          "handler": "encode",
                          "prefer": [
                            "zstd",
                            "gzip"
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "load_balancing": {
                            "try_duration": "5s",
                            "try_interval": "250ms"
                          },
                          "upstreams": [
                            {
                              "dial": "naru-blog:80"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "nas.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "encodings": {
                            "gzip": {},
                            "zstd": {}
                          },
                          "handler": "encode",
                          "prefer": [
                            "zstd",
                            "gzip"
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "load_balancing": {
                            "try_duration": "5s",
                            "try_interval": "250ms"
                          },
                          "upstreams": [
                            {
                              "dial": "host.docker.internal:5000"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "body": "Naru: 이 주소에 연결된 서비스가 없어요. / No service is configured for this address.\n",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code": 404
                }
              ]
            }
          ],
          "automatic_https": {
            "disable_redirects": true
          }
        },
        "https": {
          "logs": {
            "logger_names": {
              "blog.example.com": [
                "access"
              ],
              "nas.example.com": [
                "access"
              ]
            },
            "skip_unmapped_hosts": true
          },
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "naru.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "try_duration": "5s",
                    "try_interval": "250ms"
                  },
                  "upstreams": [
                    {
                      "dial": "naru:8080"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "blog.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "encodings": {
                            "gzip": {},
                            "zstd": {}
                          },
                          "handler": "encode",
                          "prefer": [
                            "zstd",
                            "gzip"
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "load_balancing": {
                            "try_duration": "5s",
                            "try_interval": "250ms"
                          },
                          "upstreams": [
                            {
                              "dial": "naru-blog:80"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "body": "Naru: 이 주소에 연결된 서비스가 없어요. / No service is configured for this address.\n",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code": 404
                }
              ]
            }
          ],
          "automatic_https": {
            "disable_redirects": true
          }
        }
      }
    }
  }
}
