{
  "admin": {
    "listen": "unix//run/caddy/admin.sock"
  },
  "apps": {
    "http": {
      "servers": {
        "http": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "naru.example.com"
                  ],
                  "not": [
                    {
                      "path": [
                        "/.well-known/acme-challenge/*"
                      ]
                    }
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://{http.request.host}{http.request.uri}"
                    ]
                  },
                  "status_code": 307
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "naru.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "try_duration": "5s",
                    "try_interval": "250ms"
                  },
                  "upstreams": [
                    {
                      "dial": "naru:8080"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "plain.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "try_duration": "5s",
                    "try_interval": "250ms"
                  },
                  "upstreams": [
                    {
                      "dial": "naru-plain:80"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "ready.example.com"
                  ],
                  "not": [
                    {
                      "path": [
                        "/.well-known/acme-challenge/*"
                      ]
                    }
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://{http.request.host}{http.request.uri}"
                    ]
                  },
                  "status_code": 307
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "ready.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "try_duration": "5s",
                    "try_interval": "250ms"
                  },
                  "upstreams": [
                    {
                      "dial": "naru-ready:80"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "waiting.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "try_duration": "5s",
                    "try_interval": "250ms"
                  },
                  "upstreams": [
                    {
                      "dial": "naru-waiting:80"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "body": "Naru: 이 주소에 연결된 서비스가 없어요. / No service is configured for this address.\n",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code": 404
                }
              ]
            }
          ],
          "automatic_https": {
            "disable_redirects": true
          }
        },
        "https": {
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "naru.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "try_duration": "5s",
                    "try_interval": "250ms"
                  },
                  "upstreams": [
                    {
                      "dial": "naru:8080"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "ready.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "set": {
                      "Strict-Transport-Security": [
                        "max-age=63072000"
                      ]
                    }
                  }
                },
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "try_duration": "5s",
                    "try_interval": "250ms"
                  },
                  "upstreams": [
                    {
                      "dial": "naru-ready:80"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "waiting.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "try_duration": "5s",
                    "try_interval": "250ms"
                  },
                  "upstreams": [
                    {
                      "dial": "naru-waiting:80"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "body": "Naru: 이 주소에 연결된 서비스가 없어요. / No service is configured for this address.\n",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code": 404
                }
              ]
            }
          ],
          "automatic_https": {
            "disable_redirects": true
          }
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "email": "me@example.com",
                "module": "acme"
              }
            ]
          }
        ]
      }
    }
  }
}
