{
  "admin": {
    "listen": "unix//run/caddy/admin.sock"
  },
  "apps": {
    "http": {
      "servers": {
        "http": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "naru.localhost"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "try_duration": "5s",
                    "try_interval": "250ms"
                  },
                  "upstreams": [
                    {
                      "dial": "naru:8080"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "app.localhost"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "try_duration": "5s",
                    "try_interval": "250ms"
                  },
                  "upstreams": [
                    {
                      "dial": "naru-app:3000"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "body": "Naru: 이 주소에 연결된 서비스가 없어요. / No service is configured for this address.\n",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code": 404
                }
              ]
            }
          ],
          "automatic_https": {
            "disable_redirects": true
          }
        },
        "https": {
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "naru.localhost"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "try_duration": "5s",
                    "try_interval": "250ms"
                  },
                  "upstreams": [
                    {
                      "dial": "naru:8080"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "app.localhost"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "try_duration": "5s",
                    "try_interval": "250ms"
                  },
                  "upstreams": [
                    {
                      "dial": "naru-app:3000"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "body": "Naru: 이 주소에 연결된 서비스가 없어요. / No service is configured for this address.\n",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code": 404
                }
              ]
            }
          ],
          "automatic_https": {
            "disable_redirects": true
          }
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "module": "internal"
              }
            ]
          }
        ]
      }
    }
  }
}
