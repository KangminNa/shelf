# .env로 복사해 채운다. .env는 저장소에 올리지 않는다 (비밀이 들어갈 수 있다).
# 설명은 줄 끝이 아니라 따로 둔다 — 줄 끝 설명이 값으로 읽히지 않게.

# 인증서 연락처 — 만료 경고가 여기로 온다
ACME_EMAIL=you@example.com

# 관리 화면 주소. 비우면 화면에서 정한다 (v1에서 옮기면 v1의 관리 주소를 가져온다)
ADMIN_DOMAIN=

# 앱 컨테이너 네트워크. v1에서 옮길 때는 shelf-net
NARU_NETWORK=naru-net

# 이 서버의 공인 IP — DNS 진단에만 쓴다 (비우면 관리 주소를 조회해 추정)
# NARU_PUBLIC_IP=

# 데이터 폴더 (DB · 인증서 · 비밀)
# NARU_DATA=../../data
