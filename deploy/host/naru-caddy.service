# 설치형 Naru의 웹서버 (Caddy). 설정 파일은 두지 않는다 — Naru가 관리 소켓으로 통째로 밀어 넣는다.
# 처음에는 관리 소켓만 열린 설정으로 뜨고, 그다음부터는 마지막 설정(autosave)으로 이어서 뜬다 (--resume).
# Caddy 공식 패키지의 caddy.service는 끈다 — 이 유닛이 대신한다.
[Unit]
Description=Naru web server (Caddy)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=naru
Group=naru
# 80·443을 열 권한만 준다 — root로 돌지 않는다
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# 관리 소켓 자리 /run/naru — Naru와 함께 쓴다. Caddy가 멈춰도 지우지 않는다
RuntimeDirectory=naru
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
Environment=XDG_CONFIG_HOME=/var/lib/naru/caddy-config
Environment=XDG_DATA_HOME=/var/lib/naru/caddy-data
ExecStart=/usr/bin/caddy run --resume --config /etc/naru/caddy-bootstrap.json
ExecReload=/bin/kill -USR1 $MAINPID
Restart=on-failure
TimeoutStopSec=5s
LimitNOFILE=1048576
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/var/lib/naru /run/naru

[Install]
WantedBy=multi-user.target
