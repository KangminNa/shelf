# 이 파일을 .env 로 복사해서 값을 채우면 docker compose가 자동으로 읽습니다.
# .env 는 git 추적 대상이 아니라 git pull 시 충돌하지 않습니다.

# 관리 UI 도메인 — 설정하면 부팅 시 프록시(80/443)에 자동 등록됩니다.
# 앱 webhook URL도 이 도메인으로 만들어집니다: https://<ADMIN_DOMAIN>/hooks/<앱ID>
# 설정하지 않으면 GitHub이 도달할 주소가 없어 자동 배포가 동작하지 않습니다.
ADMIN_DOMAIN=shelf.example.com

# Let's Encrypt 연락처 (자동 갱신에 필요)
ACME_EMAIL=you@example.com

# Shelf 자체 CI/CD — 설정하면 POST /hooks/self 활성화
# GitHub webhook URL: https://<ADMIN_DOMAIN>/hooks/self
# 생성: openssl rand -hex 32
# SELF_DEPLOY_SECRET=
# SELF_DEPLOY_BRANCH=main
