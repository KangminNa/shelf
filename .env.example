# Server
PORT=81
NODE_ENV=production

# Reverse proxy listeners
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# CI/CD webhook server
WEBHOOK_PORT=9100

# Let's Encrypt default contact (optional — can also be entered per-issue in the UI)
# ACME_EMAIL=you@example.com

# When Shelf itself runs in Docker, the proxy reaches app containers via the
# host gateway (set automatically in docker-compose.yml):
# APP_HOST=host.docker.internal
